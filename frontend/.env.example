# Base URL of the Elevate Load Tester backend API.
# Copy this file to .env and adjust as needed.
# .env.development and .env.production already point at the Java backend on :8080.
VITE_API_BASE=http://localhost:8080

# Deployed backend (k8s cluster) — uncomment to target the deployment:
# VITE_API_BASE=http://localhost:8080
