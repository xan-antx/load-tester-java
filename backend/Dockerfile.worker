# syntax=docker/dockerfile:1
# Queue-mode worker image. Build from the repository root:
#   docker build -f backend/Dockerfile.worker -t load-tester-worker .
# Queue mode is NOT DEPLOYED (future work); this image is not built by CI.

FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY mock-target/pom.xml mock-target/
COPY backend/pom.xml backend/
COPY mock-target/src mock-target/src
COPY backend/src backend/src
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -q -pl backend -am package -DskipTests

# The worker is a polling loop, not a web server. It runs as an unprivileged user
# like the API image.
FROM eclipse-temurin:21-jre
RUN groupadd --system app && useradd --system --gid app --uid 10001 app \
    && mkdir /data && chown app:app /data
WORKDIR /app
COPY --from=build /src/backend/target/load-tester.jar app.jar
USER app
ENV DATA_DIR=/data
ENTRYPOINT ["java", "-jar", "/app/app.jar", "worker"]
