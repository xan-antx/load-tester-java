<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 4.1.2 is the latest stable release (checked on Maven Central,
        November 2026; 4.2.0 is still a release candidate). Its parent POM pins
        the versions of every Spring, Jackson, Hibernate, H2, JUnit and Mockito
        artifact; the few libraries it does not manage are pinned below.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.elevate</groupId>
    <artifactId>load-tester-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Elevate Load Tester (Java Edition)</name>
    <description>Load tester with edge-case generation, SLO verdicts and a capacity finder.</description>

    <modules>
        <module>mock-target</module>
        <module>backend</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hdrhistogram.version>2.2.2</hdrhistogram.version>
        <picocli.version>4.7.7</picocli.version>
        <jacoco.version>0.8.16</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.elevate</groupId>
                <artifactId>mock-target</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.hdrhistogram</groupId>
                <artifactId>HdrHistogram</artifactId>
                <version>${hdrhistogram.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
