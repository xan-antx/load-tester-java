{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "./mvnw.cmd -q install -DskipTests; ./mvnw.cmd -pl backend spring-boot:run"],
      "port": 8080
    },
    {
      "name": "mock-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "./mvnw.cmd -q -pl mock-target package -DskipTests; java -jar mock-target/target/mock-target-1.0.0-exec.jar"],
      "port": 8000
    }
  ]
}
